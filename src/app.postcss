@font-face {
	font-family: 'Heading';
	src: url('$lib/assets/fonts/heading.woff2') format('woff2');
	font-weight: normal;
	font-style: normal;
}

@font-face {
	font-family: 'Body';
	src: url('$lib/assets/fonts/body.woff2') format('woff2');
	font-weight: normal;
	font-style: normal;
}

@tailwind base;
@tailwind components;
@tailwind utilities;
@tailwind variants;

:root [data-theme='skeleton'] {
	--theme-font-family-base: 'Body', sans-serif;
	--theme-font-family-heading: 'Heading', sans-serif;
}

@layer base {
	h1,
	h2,
	h3,
	h4,
	h5,
	h6 {
		@apply font-heading;
		/* -webkit-font-smoothing: antialiased !important; */
		font-synthesis: none !important;
	}

	body {
		@apply font-body;
		/* -webkit-font-smoothing: antialiased !important; */
		font-synthesis: none !important;
	}
}

html,
body {
	@apply h-full;
}

body {
	background-image: radial-gradient(
			at 0% 0%,
			rgba(var(--color-secondary-500) / 0.33) 0px,
			transparent 90%
		),
		radial-gradient(at 98% 1%, rgba(var(--color-error-500) / 0.33) 0px, transparent 90%),
		radial-gradient(at 0% 98%, rgba(var(--color-secondary-500) / 0.33) 0px, transparent 50%),
		radial-gradient(at 98% 98%, rgba(var(--color-tertiary-500) / 0.33) 0px, transparent 50%);
	background-attachment: fixed;
	background-position: center;
	background-repeat: no-repeat;
	background-size: cover;
}
